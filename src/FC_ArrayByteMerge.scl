FUNCTION "FC_ArrayByteMerge" : Void
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : ''
FAMILY : 'DataConv'
VERSION : '1.2'
//
// Liest zwei frei waehlbare BYTE-Stellen aus einem DB-Array und fuehrt
// sie zum gewuenschten Zieldatentyp zusammen.
//
// HINWEIS: i_Array muss VAR_IN_OUT sein, da ARRAY[*] in TIA Portal
//          nur als IN_OUT-Parameter funktioniert (nicht als INPUT).
//          Das Array wird nicht veraendert, nur gelesen.
//
// Aufruf-Beispiel (aus OB/FB heraus):
//   "FC_ArrayByteMerge"(
//       i_Array   := "MyDB".RawData,   // ARRAY[0..20] OF BYTE
//       i_IdxHigh := DINT#1,           // DB[1]  -> Bits 15..8
//       i_IdxLow  := DINT#6,           // DB[6]  -> Bits  7..0
//       o_ResultInt  => myIntValue,
//       o_Valid      => ok);

   VAR_IN_OUT
      i_Array   : ARRAY[*] OF Byte;  // DB-Array (wird nur gelesen, nicht veraendert)
   END_VAR

   VAR_INPUT
      i_IdxHigh : DInt;   // Index des High-Bytes (Bits 15..8)
      i_IdxLow  : DInt;   // Index des Low-Bytes  (Bits  7..0)
   END_VAR

   VAR_OUTPUT
      o_ResultWord : Word;
      o_ResultInt  : Int;
      o_ResultUInt : UInt;
      o_Valid      : Bool;
   END_VAR

   VAR_TEMP
      tmpWord : Word;
      arrLow  : DInt;
      arrHigh : DInt;
   END_VAR

BEGIN
   o_ResultWord := WORD#16#0000;
   o_ResultInt  := 0;
   o_ResultUInt := 0;
   o_Valid      := FALSE;

   arrLow  := LOWER_BOUND(ARR := i_Array, DIM := 1);
   arrHigh := UPPER_BOUND(ARR := i_Array, DIM := 1);

   IF (i_IdxHigh >= arrLow) AND (i_IdxHigh <= arrHigh)
  AND (i_IdxLow  >= arrLow) AND (i_IdxLow  <= arrHigh) THEN

      tmpWord.%B1 := i_Array[i_IdxHigh];
      tmpWord.%B0 := i_Array[i_IdxLow];

      o_ResultWord := tmpWord;
      o_ResultInt  := WORD_TO_INT(tmpWord);
      o_ResultUInt := WORD_TO_UINT(tmpWord);
      o_Valid      := TRUE;

   END_IF;

END_FUNCTION
